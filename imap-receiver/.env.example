POSTGRES_DB=imap_receiver
POSTGRES_USER=imap_receiver
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Local account configuration (never commit real values).
BANKING_IMAP_USERNAME=banking@example.com
BANKING_IMAP_PASSWORD='replace_with_your_mailbox_password'
RECEIVER_DB_PASSWORD='replace_with_at_least_32_random_alphanumeric_characters'

# Current deployment still reads IMAP/runtime passwords from secrets/*.txt and
# the account username from PostgreSQL. These three values are a local reference;
# changing them alone does not rotate passwords or change a registered account.
