FROM python:3.14-slim-bookworm AS python
FROM postgres:17-bookworm
COPY --from=python /usr/local /usr/local
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY processing /app/processing
COPY imap-receiver /app/imap-receiver
RUN pip install --no-cache-dir /app/processing
ENTRYPOINT ["python", "-m", "unittest", "discover", "-s", "/app/processing/tests", "-v"]
