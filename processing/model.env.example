# Copy locally to model.env. Never commit real endpoint or credential values.
MODEL_BASE_URL=https://model.example.invalid/v1
MODEL_PROFILE=bank-extraction-baseline
MODEL_ALIAS=fast
MODEL_BACKEND=llama-swap
MODEL_SOCKET_TIMEOUT_SECONDS=1140
# Live thinking probes exhausted even 6144 tokens; opt in only for evaluation.
MODEL_THINKING=false
# Best verified baseline; lower-temperature prompt experiments regressed negatives.
MODEL_TEMPERATURE=0.7
MODEL_AUTH=basic
MODEL_USERNAME_FILE=/run/secrets/model_username
MODEL_PASSWORD_FILE=/run/secrets/model_password
MODEL_CONTEXT_TOKENS=8192
MODEL_OUTPUT_TOKENS=6144
MODEL_MIN_OUTPUT_TOKENS=4096
# Record the exact model file hash/revision when available; an alias is mutable.
# MODEL_REVISION=
# MODEL_CA_FILE=/run/secrets/model_ca
